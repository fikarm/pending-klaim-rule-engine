{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pending-klaim-claim-facts-schema",
  "title": "Skema Fakta Klaim Pending Klaim",
  "type": "object",
  "required": ["schema_version", "claim"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "run_id": { "type": "string" },
        "extracted_at": { "type": "string", "format": "date-time" },
        "catalog_version": { "type": "string" },
        "mapping_version": { "type": "string" },
        "llm_model": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "encounter_type", "diagnoses"],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "encounter_type": { "enum": ["RI", "RJ"] },
        "admit_date": { "type": "string", "format": "date" },
        "discharge_date": { "type": "string", "format": "date" },
        "visit_date": { "type": "string", "format": "date" },
        "patient": {
          "type": "object",
          "description": "Opsional; hanya atribut non-identitas langsung yang relevan untuk aturan.",
          "additionalProperties": false,
          "properties": {
            "pseudonym_id": { "type": "string" },
            "sex": { "type": "string" },
            "age_years": { "type": ["integer", "null"], "minimum": 0 },
            "age_days": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "diagnoses": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnosis" }
        },
        "procedures": {
          "type": "array",
          "items": { "$ref": "#/$defs/procedure" },
          "default": []
        },
        "documents_available": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" },
      "default": []
    },
    "quality": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "diagnosis": {
      "type": "object",
      "required": ["code", "position"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "position": { "enum": ["primary", "secondary"] },
        "sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "procedure": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "fact": {
      "type": "object",
      "required": ["field", "kind", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["measurement", "category", "flag", "category_list", "text", "event"]
        },
        "status": { "enum": ["present", "absent", "conflicting"] },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "normalization": { "type": "object", "additionalProperties": true },
        "conflict_details": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/conflict_detail" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "present" } } },
          "then": { "required": ["value"] }
        },
        {
          "if": { "properties": { "status": { "const": "conflicting" } } },
          "then": { "required": ["conflict_details"] }
        }
      ]
    },
    "conflict_detail": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": true,
      "properties": {
        "method": {
          "enum": ["db_query", "llm_extraction", "rule_derived", "manual_entry"]
        },
        "source_id": { "type": "string" },
        "document_id": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "text_span": { "type": "string" },
        "derived_from": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
